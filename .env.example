# Required
STEAM_API_KEY=            # free key from https://steamcommunity.com/dev/apikey
SLACK_WEBHOOK_URL=        # Slack incoming webhook for the channel that gets the pings

# Optional (defaults shown)
# DATA_DIR=./data                         # where the SQLite database lives; must be persistent
# PORT=3000
# TRACKING_WINDOW_DAYS=14
# GAIN_WINDOW_DAYS=5
# FOLLOWER_GAIN_THRESHOLD=150
# EXCLUDE_NSFW=true
# APP_LIST_INTERVAL_MINUTES=20
# DETAILS_REFRESH_HOURS=12
# FOLLOWER_INTERVAL_MINUTES=60            # candidates far from the threshold
# FOLLOWER_INTERVAL_NEAR_MINUTES=15       # candidates within 50% of the threshold
# FOLLOWER_INTERVAL_HOT_MINUTES=5         # candidates within 20% of the threshold
# FOLLOWER_INTERVAL_NON_CANDIDATE_MINUTES=360
# STORE_THROTTLE_MS=1500
# COMMUNITY_THROTTLE_MS=1000
