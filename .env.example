# Required (set these in Vercel: Project > Settings > Environment Variables)
STEAM_API_KEY=            # free key from https://steamcommunity.com/dev/apikey
SLACK_WEBHOOK_URL=        # Slack incoming webhook for the channel that gets the pings
REDIS_URL=                # added automatically when you connect a Redis database in Vercel's Storage tab
CRON_SECRET=              # any long random string; Vercel Cron sends it so nobody else can trigger runs
GITHUB_DISPATCH_TOKEN=    # fine-grained GitHub token, Actions: Read and write on this repo (see README)

# Optional (defaults shown)
# TRACKING_WINDOW_DAYS=14
# GAIN_WINDOW_DAYS=5
# FOLLOWER_GAIN_THRESHOLD=50
# EXCLUDE_NSFW=true
# FOLLOWER_INTERVAL_HOURS=1               # follower reads for pages halfway to the threshold
# FOLLOWER_INTERVAL_WARM_HOURS=4          # ... for pages at 20% of the threshold
# FOLLOWER_INTERVAL_QUIET_HOURS=12        # ... for everything else
# NON_CANDIDATE_RECHECK_HOURS=72          # how often non-matching pages get their dev/publisher/demo re-read
# RUN_BUDGET_SECONDS=240                  # keep below maxDuration (300) in vercel.json
# STORE_THROTTLE_MS=1500
# COMMUNITY_THROTTLE_MS=1000               # gap between follower reads; raise it if logs show HTTP 429
